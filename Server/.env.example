# Database Configuration
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=prestar
DB_HOST=localhost
DB_PORT=5432
DATABASE_URL=postgres://user:password@localhost:5432/prestar

# JWT Session Configuration
JWT_SECRET=your_32_plus_character_jwt_secret_here
JWT_EXPIRES_IN=6h

# Frontend Origins (CORS)
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Gmail API Configuration (OAuth2)
GMAIL_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your_google_oauth_client_secret
GMAIL_REFRESH_TOKEN=your_google_oauth_refresh_token
GMAIL_USER=your_verified_gmail_sender@gmail.com

# OTP Security Configuration
OTP_SECRET=your_random_32_plus_character_hmac_secret_here
OTP_DAILY_CAP=400
PORT=3000
